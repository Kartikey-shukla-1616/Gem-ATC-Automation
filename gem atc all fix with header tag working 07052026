        self.preview_layout = []
        self.preview_page_objects = {}
        self.preview_generation_id += 1
        self.heading_pagebreak_lines.clear()

        if self.temp_dir and os.path.exists(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)
        self.temp_dir = tempfile.mkdtemp()
        self.clear_preview_panel()

    def clear_preview_panel(self):
        self.preview_canvas.delete("all")
        self.preview_canvas.configure(scrollregion=(0, 0, 0, 0))
        self.page_info_var.set("Pages: 0")
        self.removed_pages_var.set("Removed pages: None")
        self.preview_cache = {}
        self.preview_rendered_pages = set()
        self.preview_layout = []
        self.preview_page_objects = {}

    def manual_preview_click(self):
        if not PDF2IMAGE_AVAILABLE:
            messagebox.showwarning("Preview disabled", "Live preview ke liye pdf2image + poppler chahiye. sirf Export to PDF ka use karein.")
            return
        if self.preview_thread and self.preview_thread.is_alive():
            messagebox.showinfo("Preview", "Preview already running, please wait.")
            return
        self.progress.config(mode="determinate")
        self.progress_var.set(0)
        self.wait_label.config(text="Generating preview, please wait...")
        self.status_text.set("Generating preview PDF...")
        self.preview_thread = Thread(target=self._preview_worker, daemon=True)
        self.preview_thread.start()

    def _preview_worker(self):
        tmppdf = os.path.join(self.temp_dir, "livepreview.pdf")
        generation = self.preview_generation_id + 1
        self.preview_generation_id = generation
        try:
            self.pdf_preview_render(tmppdf, showmessage=False)
            if not os.path.exists(tmppdf) or os.path.getsize(tmppdf) == 0:
                self.after(0, self.handle_no_preview_content)
                return

            with pdfplumber.open(tmppdf) as pdf:
                totalpages = len(pdf.pages)

            self.preview_pdf_path = tmppdf
            self.preview_total_pages = totalpages
            self.preview_removed_indices = set()

            self.after(0, lambda: self._setup_preview_canvas(totalpages, generation))
        except Exception as e:
            def showerr():
                self.status_text.set("Error while generating preview.")
                messagebox.showerror("Preview Error", f"Preview failed:\n{e}")
                self.progress_var.set(0)
                self.wait_label.config(text="")
            self.after(0, showerr)

    def handle_no_preview_content(self):
        self.clear_preview_panel()
        self.status_text.set("No content to preview.")
        self.page_info_var.set("Pages: 0")
        self.progress_var.set(0)
        self.wait_label.config(text="")

    def _setup_preview_canvas(self, totalpages, generation):
        if generation != self.preview_generation_id:
            return

        self.clear_preview_panel()
        self.page_info_var.set(f"Pages: {totalpages}")
        self.removed_pages_var.set("Removed pages: None")
        self.status_text.set("Preview ready.")
        self.progress_var.set(100)
        self.wait_label.config(text="")
        self.update_idletasks()

        canvasw = max(360, self.preview_canvas.winfo_width())
        pagew = max(260, min(500, canvasw - 30))
        self.preview_target_width = pagew

        y = 12
        self.preview_layout = []
        self.preview_page_objects = {}

        visible_pages = [p for p in range(1, totalpages + 1) if p not in self.preview_removed_indices]

        for display_index, pageno in enumerate(visible_pages, start=1):
            labely = y
            imgy = labely + 24
            approxh = int(pagew * 1.4142)

            self.preview_canvas.create_text(
                10, labely,
                anchor="nw",
                text=f"Page {pageno} / {totalpages}",
                fill="#a5b4fc",
                font=("Arial", 10, "bold"),
                tags=(f"page_label_{pageno}",)
            )

            rectid = self.preview_canvas.create_rectangle(
                10, imgy, 10 + pagew, imgy + approxh,
                outline="#334155", fill="#0f172a", width=1,
                tags=(f"page_rect_{pageno}",)
            )

            loadingid = self.preview_canvas.create_text(
                10 + pagew / 2, imgy + approxh / 2,
                text="Loading preview...",
                fill="#93c5fd",
                font=("Arial", 10, "italic"),
                tags=(f"page_loading_{pageno}",)
            )

            info = {
                "page_no": pageno,
                "top": labely,
                "img_top": imgy,
                "left": 10,
                "width": pagew,
                "height": approxh,
                "bottom": imgy + approxh + 16,
                "rect_id": rectid,
                "loading_id": loadingid,
                "image_id": None
            }
            self.preview_layout.append(info)
            self.preview_page_objects[pageno] = info
            y = imgy + approxh + 28

        self.preview_canvas.configure(scrollregion=(0, 0, canvasw, y + 20))
        self._schedule_preview_visible_render()

    def _schedule_preview_visible_render(self):
        if self.preview_update_after:
            try:
                self.after_cancel(self.preview_update_after)
            except Exception:
                pass
        self.preview_update_after = self.after(60, self._render_visible_preview_pages)

    def _render_visible_preview_pages(self):
        self.preview_update_after = None
        if not self.preview_pdf_path or not self.preview_layout or self.preview_loading:
            return

        top = self.preview_canvas.canvasy(0)
        bottom = top + self.preview_canvas.winfo_height()

        pages_to_render = []
        for info in self.preview_layout:
            if info["bottom"] >= top - 300 and info["top"] <= bottom + 300:
                if info["page_no"] not in self.preview_rendered_pages:
                    pages_to_render.append(info["page_no"])

        if not pages_to_render:
            return

        self.preview_loading = True
        generation = self.preview_generation_id

        def worker():
            try:
                for page_no in pages_to_render:
                    if generation != self.preview_generation_id:
                        return
                    self._render_one_preview_page(page_no, generation)
            finally:
                self.preview_loading = False

        Thread(target=worker, daemon=True).start()

    def _render_one_preview_page(self, page_no, generation):
        with self.preview_lock:
            if page_no in self.preview_rendered_pages:
                return

            kwargs = {
                "dpi": 115,
                "first_page": page_no,
                "last_page": page_no,
                "fmt": "ppm",
                "thread_count": 1
            }
            if POPPLER_PATH:
                kwargs["poppler_path"] = POPPLER_PATH

            pages = convert_from_path(self.preview_pdf_path, **kwargs)
            if not pages:
                return

            img = pages[0].convert("RGB")
            w, h = img.size
            target_w = self.preview_target_width
            target_h = int(h * target_w / w)
            resized = img.resize((target_w, target_h), Image.LANCZOS)
            tkimg = ImageTk.PhotoImage(resized)
            self.preview_cache[page_no] = tkimg

            self.after(0, lambda: self._place_preview_image(page_no, tkimg, target_h, generation))

    def _place_preview_image(self, page_no, tkimg, target_h, generation):
        if generation != self.preview_generation_id:
            return

        info = self.preview_page_objects.get(page_no)
        if info is None:
            return

        left = info["left"]
        img_top = info["img_top"]
        width = info["width"]

        self.preview_canvas.coords(info["rect_id"], left, img_top, left + width, img_top + target_h)
        self.preview_canvas.delete(info["loading_id"])

        if info["image_id"] is not None:
            self.preview_canvas.delete(info["image_id"])

        image_id = self.preview_canvas.create_image(left, img_top, anchor="nw", image=tkimg, tags=(f"page_img_{page_no}",))
        info["image_id"] = image_id
        info["height"] = target_h
        info["bottom"] = img_top + target_h + 16

        self.preview_rendered_pages.add(page_no)
        self._reflow_preview_layout_from(page_no)

    def _reflow_preview_layout_from(self, start_page_no):
        start_index = None
        for idx, item in enumerate(self.preview_layout):
            if item["page_no"] == start_page_no:
                start_index = idx
                break
        if start_index is None:
            return

        if start_index == 0:
            y = 12
        else:
            y = self.preview_layout[start_index - 1]["bottom"] + 12

        for idx in range(start_index, len(self.preview_layout)):
            item = self.preview_layout[idx]
            label_y = y
            img_y = label_y + 24

            item["top"] = label_y
            item["img_top"] = img_y
            item["bottom"] = img_y + item["height"] + 16

            self.preview_canvas.coords(f"page_label_{item['page_no']}", 10, label_y)
            self.preview_canvas.coords(item["rect_id"], 10, img_y, 10 + item["width"], img_y + item["height"])

            if item["image_id"] is not None:
                self.preview_canvas.coords(item["image_id"], 10, img_y)

            y = item["bottom"] + 12

        self.preview_canvas.configure(scrollregion=(0, 0, max(360, self.preview_canvas.winfo_width()), y + 20))

    def _preview_scroll_command(self, *args):
        self.preview_canvas.yview(*args)
        self._schedule_preview_visible_render()

    def _on_preview_canvas_resize(self, event=None):
        if not self.preview_layout:
            return

        canvasw = max(360, self.preview_canvas.winfo_width())
        new_page_w = max(260, min(500, canvasw - 30))

        if abs(new_page_w - self.preview_target_width) < 5:
            self._schedule_preview_visible_render()
            return

        self.preview_target_width = new_page_w
        self.preview_cache.clear()
        self.preview_rendered_pages.clear()

        self.preview_canvas.delete("all")
        totalpages = self.preview_total_pages
        self.preview_layout = []
        self.preview_page_objects = {}

        y = 12
        visible_pages = [p for p in range(1, totalpages + 1) if p not in self.preview_removed_indices]

        for pageno in visible_pages:
            labely = y
            imgy = labely + 24
            approxh = int(new_page_w * 1.4142)

            self.preview_canvas.create_text(
                10, labely, anchor="nw",
                text=f"Page {pageno} / {totalpages}",
                fill="#a5b4fc", font=("Arial", 10, "bold"),
                tags=(f"page_label_{pageno}",)
            )

            rectid = self.preview_canvas.create_rectangle(
                10, imgy, 10 + new_page_w, imgy + approxh,
                outline="#334155", fill="#0f172a", width=1,
                tags=(f"page_rect_{pageno}",)
            )

            loadingid = self.preview_canvas.create_text(
                10 + new_page_w / 2, imgy + approxh / 2,
                text="Loading preview...",
                fill="#93c5fd", font=("Arial", 10, "italic"),
                tags=(f"page_loading_{pageno}",)
            )

            info = {
                "page_no": pageno,
                "top": labely,
                "img_top": imgy,
                "left": 10,
                "width": new_page_w,
                "height": approxh,
                "bottom": imgy + approxh + 16,
                "rect_id": rectid,
                "loading_id": loadingid,
                "image_id": None
            }
            self.preview_layout.append(info)
            self.preview_page_objects[pageno] = info
            y = imgy + approxh + 28

        self.preview_canvas.configure(scrollregion=(0, 0, canvasw, y + 20))
        self._schedule_preview_visible_render()

    def _on_preview_mousewheel(self, event):
        self.preview_canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")
        self._schedule_preview_visible_render()

    def _on_preview_mousewheel_linux(self, event):
        if event.num == 4:
            self.preview_canvas.yview_scroll(-3, "units")
        elif event.num == 5:
            self.preview_canvas.yview_scroll(3, "units")
        self._schedule_preview_visible_render()

    def _parse_page_input(self, textvalue, maxpage):
        pages = set()
        textvalue = textvalue.strip()
        if not textvalue:
            return pages

        for chunk in textvalue.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            if "-" in chunk:
                parts = chunk.split("-")
                if len(parts) != 2:
                    continue
                try:
                    start = int(parts[0].strip())
                    end = int(parts[1].strip())
                    if start > end:
                        start, end = end, start
                    for p in range(start, end + 1):
                        if 1 <= p <= maxpage:
                            pages.add(p)
                except Exception:
                    pass
            else:
                try:
                    p = int(chunk)
                    if 1 <= p <= maxpage:
                        pages.add(p)
                except Exception:
                    pass

        return pages

    def _remove_line_text_content(self, line):
        try:
            line_start = f"{line}.0"
            line_end = f"{line}.0 lineend"
            existing = self.text.get(line_start, line_end)
            if existing is not None and existing != "":
                self.text.delete(line_start, line_end)
        except Exception:
            pass

    def _remove_lines_everywhere(self, lines_to_delete):
        if not lines_to_delete:
            return

        sorted_lines = sorted(lines_to_delete, reverse=True)
        for line in sorted_lines:
            self._delete_editor_line_image_only(line)
            self._remove_line_text_content(line)

        self.tracked_images = [r for r in self.tracked_images if r[0] not in lines_to_delete]
        self.pdf_images = [r for r in self.pdf_images if r[2] not in lines_to_delete]
        self.docs_images = [r for r in self.docs_images if r[2] not in lines_to_delete]
        self.image_archive = [e for e in self.image_archive if e["line"] not in lines_to_delete]
        self.heading_pagebreak_lines -= set(lines_to_delete)

    def remove_pages_from_preview_input(self):
        if self.preview_total_pages == 0 or not self.preview_source_map:
            messagebox.showinfo("Info", "Pehle Preview PDF generate karein.")
            return

        txt = self.remove_page_entry.get().strip()
        if not txt:
            messagebox.showinfo("Info", "Page number dalo. Example 39 or 39,40 or 39-45")
            return

        pages_to_remove = self._parse_page_input(txt, self.preview_total_pages)
        if not pages_to_remove:
            messagebox.showerror("Error", "Valid page numbers nahi mile.")
            return

        self._remove_pages_by_preview_numbers(sorted(pages_to_remove))

    def _remove_pages_by_preview_numbers(self, page_numbers):
        lines_to_delete = set()

        for page_no in page_numbers:
            if page_no < 1 or page_no > len(self.preview_source_map):
                continue
            pageinfo = self.preview_source_map[page_no - 1]
            for src in pageinfo.get("sources", []):
                if "line" in src:
                    lines_to_delete.add(src["line"])

        if not lines_to_delete:
            messagebox.showinfo("Info", "Selected preview pages me removable source nahi mila.")
            return

        self._remove_lines_everywhere(lines_to_delete)
        self.preview_removed_indices.update(page_numbers)

        removed_display = ", ".join(str(x) for x in sorted(self.preview_removed_indices))
        self.removed_pages_var.set(f"Removed pages: {removed_display}")
        self.status_text.set(f"Removed preview pages: {removed_display}")
        self._setup_preview_canvas(self.preview_total_pages, self.preview_generation_id)
        self.on_editor_change()

    def reset_removed_pages(self):
        self.remove_page_entry.delete(0, tk.END)
        self.preview_removed_indices = set()
        self.manual_preview_click()

    def compress_and_save_pdf(self):
        tmppdf = os.path.join(self.temp_dir, "compressbase.pdf")
        try:
            self.pdf_preview_render(tmppdf, showmessage=False)
        except Exception as e:
            messagebox.showerror("Error", f"Failed to generate base PDF:\n{e}")
            return

        if not os.path.exists(tmppdf) or os.path.getsize(tmppdf) == 0:
            messagebox.showinfo("Info", "No content to compress.")
            return

        savepath = filedialog.asksaveasfilename(defaultextension=".pdf", filetypes=[("PDF Files", "*.pdf")], title="Save Compressed PDF")
        if not savepath:
            return

        targetval = self.target_size_mb.get()
        unit = self.target_size_unit.get()
        if targetval <= 0:
            messagebox.showerror("Error", "Target size must be > 0.")
            return

        targetbytes = int(targetval * 1024 * 1024) if unit == "MB" else int(targetval * 1024)

        self.progress.config(mode="determinate")
        self.progress_var.set(0)
        self.wait_label.config(text="Compressing PDF, please wait...")
        self.status_text.set("Trying to compress PDF near selected size...")
        t = Thread(target=self._compress_worker, args=(tmppdf, savepath, targetbytes), daemon=True)
        t.start()

    def _compress_worker(self, srcpdf, dstpdf, targetbytes):
        try:
            from reportlab.pdfgen import canvas as rlcanvas
            kwargs = {}
            if POPPLER_PATH:
                kwargs["poppler_path"] = POPPLER_PATH
            pages = convert_from_path(srcpdf, dpi=150, **kwargs)
            totalpages = len(pages) or 1
            qualities = [95, 85, 75, 60, 50, 40, 30]
            bestpath = None
            bestsize = None

            for qidx, q in enumerate(qualities, start=1):
                tmpout = os.path.join(self.temp_dir, f"compress_q{q}.pdf")
                c = rlcanvas.Canvas(tmpout, pagesize=A4)
                pw, ph = A4

                for pidx, img in enumerate(pages, start=1):
                    bufname = os.path.join(self.temp_dir, f"page_{q}_{pidx}.jpg")
                    img.save(bufname, format="JPEG", quality=q)
                    pageimg = Image.open(bufname)
                    iw, ih = pageimg.size
                    scale = min(pw / iw, ph / ih)
                    nw, nh = iw * scale, ih * scale
                    x = (pw - nw) / 2
                    y = (ph - nh) / 2
                    c.drawImage(ImageReader(pageimg), x, y, width=nw, height=nh)
                    c.showPage()
                    try:
                        os.remove(bufname)
                    except Exception:
                        pass

                    progress = ((qidx - 1) * totalpages + pidx) / (totalpages * len(qualities)) * 100.0
                    self.after(0, self.progress_var.set, progress)

                c.save()
                sz = os.path.getsize(tmpout)

                if sz <= targetbytes:
                    bestpath = tmpout
                    bestsize = sz
                    break

                if bestpath is None or sz < bestsize:
                    bestpath = tmpout
                    bestsize = sz

            if bestpath:
                shutil.copy(bestpath, dstpdf)

            def done():
                if bestpath and os.path.exists(dstpdf):
                    finalkb = os.path.getsize(dstpdf) / 1024
                    self.status_text.set(f"Compressed PDF saved. Size {finalkb:.1f} KB.")
                    messagebox.showinfo("Done", f"Compressed PDF saved.\nsize {finalkb:.1f} KB")
                else:
                    self.status_text.set("Compression failed.")
                    messagebox.showerror("Error", "Could not compress PDF.")
                self.progress_var.set(0)
                self.wait_label.config(text="")

            self.after(0, done)
        except Exception as e:
            def showerr():
                self.progress_var.set(0)
                self.wait_label.config(text="")
                self.status_text.set("Error during compression.")
                messagebox.showerror("Error", f"Compression failed:\n{e}")
            self.after(0, showerr)

    def export_to_pdf(self):
        outputpath = filedialog.asksaveasfilename(defaultextension=".pdf", filetypes=[("PDF Files", "*.pdf")], title="Save ATC as PDF")
        if not outputpath:
            return
        if self.export_thread and self.export_thread.is_alive():
            messagebox.showinfo("Export", "Export already running, please wait.")
            return
        self.progress.config(mode="determinate")
        self.progress_var.set(0)
        self.wait_label.config(text="Exporting PDF, please wait...")
        self.status_text.set(f"Exporting to {outputpath} ...")
        self.export_thread = Thread(target=self._export_worker, args=(outputpath,), daemon=True)
        self.export_thread.start()

    def _export_worker(self, outputfile):
        try:
            elems, _, frame_left, frame_width, frame_height = self.build_story_and_preview_source_map()
            if not elems:
                open(outputfile, "wb").close()
            else:
                frame_margin_bottom = self.page_margin_bottom + 120
                frame = Frame(frame_left, frame_margin_bottom, frame_width, frame_height, id="bodyframe")
                template = PageTemplate(id="gematc", frames=[frame], onPage=self.on_page)
                doc = BaseDocTemplate(outputfile, pagesize=A4, pageTemplates=[template])
                doc.build(elems)

            def done():
                self.progress_var.set(100)
                self.wait_label.config(text="")
                self.status_text.set(f"PDF exported {outputfile}")
                messagebox.showinfo("Success", "PDF has been exported successfully.")

            self.after(0, done)
        except Exception as e:
            def showerr():
                self.status_text.set("Error exporting PDF.")
                messagebox.showerror("Export Error", f"PDF export failed:\n{e}")
                self.progress_var.set(0)
                self.wait_label.config(text="")
            self.after(0, showerr)


