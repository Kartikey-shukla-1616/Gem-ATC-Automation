    def extract_tc(self):
        filepath = filedialog.askopenfilename(title="Select GEM Tender PDF", filetypes=[("PDF Files", "*.pdf")])
        if not filepath:
            return
        self.status_text.set(f"Reading {os.path.basename(filepath)} ...")
        try:
            with pdfplumber.open(filepath) as pdf:
                startmarker = "Buyer Added Bid Specific Terms and Conditions"
                endmarker = "Disclaimer"
                capture = False
                headinginserted = False
                self.text.delete("1.0", tk.END)
                self.heading_pagebreak_lines.clear()

                for page in pdf.pages:
                    pagetext = page.extract_text() or ""
                    if not pagetext:
                        continue
                    lines = pagetext.splitlines()
                    chars = page.chars

                    linesbyy = {}
                    for ch in chars:
                        y = round(ch["top"], 1)
                        linesbyy.setdefault(y, []).append(ch)

                    boldlines = set()
                    for _, chlist in linesbyy.items():
                        boldcount = sum(1 for c in chlist if "Bold" in c.get("fontname", ""))
                        if boldcount and boldcount / len(chlist) >= 0.6:
                            texthere = "".join(c["text"] for c in chlist).strip()
                            if texthere:
                                boldlines.add(texthere)

                    for rawline in lines:
                        line = rawline.strip()
                        if startmarker in line:
                            capture = True
                            if not headinginserted:
                                self.text.insert(tk.END, "\n")
                                hstart = self.text.index("end-1c")
                                self.text.insert(tk.END, startmarker)
                                hend = self.text.index("end-1c")
                                self.text.tag_add("heading", hstart, hend)
                                self.text.tag_add("center", hstart, hend)
                                self.heading_pagebreak_lines.add(int(hstart.split(".")[0]))
                                self.text.insert(tk.END, "\n")
                                headinginserted = True
                            continue

                        if capture and endmarker in line:
                            capture = False
                            break

                        if not capture:
                            continue
                        if is_probable_page_number(line):
                            continue
                        if not line:
                            continue
                        if is_garbage(line):
                            continue

                        isboldheading = False
                        for b in boldlines:
                            if line.startswith(b) or b.startswith(line):
                                isboldheading = True
                                break

                        if isboldheading:
                            self.text.insert(tk.END, "\n")
                            startidx = self.text.index("end-1c")
                            self.text.insert(tk.END, line)
                            endidx = self.text.index("end-1c")
                            self.text.tag_add("bold", startidx, endidx)
                            self.text.insert(tk.END, "\n")
                        else:
                            self.text.insert(tk.END, line + "\n")

            self.status_text.set("Terms & Conditions extracted.")
            messagebox.showinfo("Success", "Terms & Conditions extracted successfully.")
            self.on_editor_change()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to read PDF:\n{e}")
            self.status_text.set("Error reading PDF.")

    def build_story_and_preview_source_map(self):
        styles = getSampleStyleSheet()

        def heading_style(sz):
            return ParagraphStyle(
                name=f"TCHeading{sz}",
                parent=styles["Heading2"],
                alignment=TA_CENTER,
                fontName=self.bold_font_name,
                fontSize=sz,
                leading=sz + 4,
                spaceAfter=8,
                spaceBefore=12
            )

        def normal_style(sz):
            return ParagraphStyle(
                name=f"TCLine{sz}",
                parent=styles["Normal"],
                fontName=self.font_name,
                fontSize=sz,
                leading=sz + 3,
                spaceBefore=4,
                spaceAfter=2,
                alignment=TA_LEFT
            )

        frame_left = 40
        content_top_offset = 160
        footer_safe_height = 120
        frame_width = A4[0] - frame_left - 40
        frame_height = A4[1] - content_top_offset - self.page_margin_bottom - footer_safe_height

        elems = []
        preview_source_map = []
        current_page_sources = []
        current_page_has_content = False

        total_lines = int(self.text.index("end-1c").split('.')[0])
        images_by_line = {}
        for line, pilimg, align in self.tracked_images:
            images_by_line.setdefault(line, []).append((pilimg, align))

        usablew = frame_width * 0.95
        usableh = frame_height * 0.82

        def flush_page_sources():
            nonlocal current_page_sources, current_page_has_content
            if current_page_has_content or current_page_sources:
                preview_source_map.append({"sources": list(current_page_sources)})
            current_page_sources = []
            current_page_has_content = False

        for i in range(1, total_lines + 1):
            linetext = self.text.get(f"{i}.0", f"{i}.0 lineend").strip()
            tags = self.text.tag_names(f"{i}.0")

            if i in self.heading_pagebreak_lines and (elems or current_page_has_content or current_page_sources):
                while elems and isinstance(elems[-1], Spacer):
                    elems.pop()
                elems.append(PageBreak())
                flush_page_sources()

            if linetext:
                size = 12
                for tag in tags:
                    if tag.startswith("size"):
                        try:
                            size = int(tag.replace("size", ""))
                        except Exception:
                            pass

                if "heading" in tags:
                    style = heading_style(size)
                else:
                    style = normal_style(size)

                if "heading" in tags or "center" in tags:
                    style.alignment = TA_CENTER
                elif "right" in tags:
                    style.alignment = TA_RIGHT
                else:
                    style.alignment = TA_LEFT

                if "bold" in tags or "heading" in tags:
                    style.fontName = self.bold_font_name

                para = Paragraph(linetext, style)

                if i in images_by_line:
                    for pilimg, aligntag in images_by_line[i]:
                        imgpath, realw, realh = self._cache_image_once(pilimg)
                        ratio = min(usablew / realw, usableh / realh, 1.0)
                        imgw = realw * ratio
                        imgh = realh * ratio

                        rlimg = RLImage(imgpath, width=imgw, height=imgh)
                        rlimg.hAlign = aligntag.upper() if aligntag in ("left", "right", "center") else "CENTER"
                        rlimg._restrictSize(usablew, usableh)

                        block = KeepTogether([para, Spacer(1, 6), rlimg, Spacer(1, 8)])
                        elems.append(block)
                        current_page_sources.append({"type": "text", "line": i})
                        current_page_sources.append({"type": "image", "line": i})
                        current_page_has_content = True
                else:
                    elems.append(para)
                    current_page_sources.append({"type": "text", "line": i})
                    current_page_has_content = True

            elif i in images_by_line:
                for pilimg, aligntag in images_by_line[i]:
                    imgpath, realw, realh = self._cache_image_once(pilimg)
                    ratio = min(usablew / realw, usableh / realh, 1.0)
                    imgw = realw * ratio
                    imgh = realh * ratio

                    rlimg = RLImage(imgpath, width=imgw, height=imgh)
                    rlimg.hAlign = aligntag.upper() if aligntag in ("left", "right", "center") else "CENTER"
                    rlimg._restrictSize(usablew, usableh)
                    elems.append(Spacer(1, 6))
                    elems.append(rlimg)
                    elems.append(Spacer(1, 8))
                    current_page_sources.append({"type": "image", "line": i})
                    current_page_has_content = True

        flush_page_sources()

        while elems and isinstance(elems[-1], PageBreak):
            elems.pop()
        while preview_source_map and not preview_source_map[-1]["sources"]:
            preview_source_map.pop()

        return elems, preview_source_map, frame_left, frame_width, frame_height

    def pdf_preview_render(self, outputfile="previewtemp.pdf", showmessage=True):
        elems, preview_source_map, frame_left, frame_width, frame_height = self.build_story_and_preview_source_map()
        self.preview_source_map = preview_source_map

        if not elems:
            open(outputfile, "wb").close()
            return

        frame_margin_bottom = self.page_margin_bottom + 120
        frame = Frame(frame_left, frame_margin_bottom, frame_width, frame_height, id="bodyframe")
        template = PageTemplate(id="gematc", frames=[frame], onPage=self.on_page)
        doc = BaseDocTemplate(outputfile, pagesize=A4, pageTemplates=[template])
        doc.build(elems)

        if showmessage:
            self.status_text.set(f"PDF exported {outputfile}")

    def on_page(self, canvas, doc):
        pdfwidth, pdfheight = A4

        if self.header_img_resized is not None:
            imgwidth, imgheight = self.header_img_resized.size
            availablewidth = pdfwidth - 100
            scale = min(availablewidth / imgwidth, 1.0)
            scaledwidth = int(imgwidth * scale)
            scaledheight = int(imgheight * scale)
            xpos = (pdfwidth - scaledwidth) / 2
            ypos = pdfheight - scaledheight - 20
            canvas.drawImage(ImageReader(self.header_img_resized), xpos, ypos, width=scaledwidth, height=scaledheight, preserveAspectRatio=True)

        if self.footer_img_resized is not None:
            imgwidth, imgheight = self.footer_img_resized.size
            availablewidth = pdfwidth - 100
            scale = min(availablewidth / imgwidth, 1.0)
            scaledwidth = int(imgwidth * scale)
            scaledheight = int(imgheight * scale)
            xpos = 40
            ypos = self.page_margin_bottom
            canvas.drawImage(ImageReader(self.footer_img_resized), xpos, ypos, width=scaledwidth, height=scaledheight, preserveAspectRatio=True)

