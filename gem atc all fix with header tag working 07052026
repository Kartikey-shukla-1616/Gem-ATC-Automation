def is_garbage(line: str) -> bool:
    s = line.strip()
    if not s:
        return True
    if "cid:" in s or "(cid:" in s or "cid)" in s:
        return True
    if re.fullmatch(r"[\W_]+", s):
        return True
    if re.fullmatch(r"(cid:\d+\s*)+", s):
        return True
    if s.count("cid:") >= 2 and all(x in "\n\t " or x.isdigit() for x in s.replace("cid:", "").replace("(", "").replace(")", "")):
        return True
    if len([x for x in s if x not in "\n 0123456789()-cid:"]) == 0 and len(s) > 0:
        return True
    if len(re.findall(r"[a-zA-Z0-9\u0900-\u097F]", s)) <= 2:
        return True
    segs = s.split()
    if segs and all(seg.startswith("cid:") or set(seg) <= set("()0123456789") for seg in segs):
        return True
    return False


PAGE_NUM_REGEXES = [
    re.compile(r"^\d+$"),
    re.compile(r"^page\s+\d+$", re.IGNORECASE),
    re.compile(r"^page\s+\d+\s+of\s+\d+$", re.IGNORECASE),
    re.compile(r"^\d+\s*/\s*\d+$"),
]


def is_probable_page_number(line: str) -> bool:
    s = line.strip()
    for rg in PAGE_NUM_REGEXES:
        if rg.match(s):
            return True
    return False


