    def auto_contrast_fg(self, hexcolor):
        try:
            hexcolor = hexcolor.lstrip("#")
            if len(hexcolor) != 6:
                return "#000000"
            r = int(hexcolor[0:2], 16)
            g = int(hexcolor[2:4], 16)
            b = int(hexcolor[4:6], 16)
            brightness = 0.299 * r + 0.587 * g + 0.114 * b
            return "#000000" if brightness > 186 else "#ffffff"
        except Exception:
            return "#000000"

    def change_all_button_colors(self):
        bgcolor = colorchooser.askcolor(title="Choose button background color")[1]
        if not bgcolor:
            return
        fgcolor = self.auto_contrast_fg(bgcolor)

        def apply_on_children(parent):
            for child in parent.winfo_children():
                if isinstance(child, tk.Button):
                    try:
                        child.configure(bg=bgcolor, fg=fgcolor, activebackground=bgcolor, activeforeground=fgcolor)
                    except Exception:
                        pass
                if isinstance(child, (tk.Frame, tk.Canvas, tk.Toplevel, tk.LabelFrame)):
                    apply_on_children(child)

        apply_on_children(self)
        self.status_text.set("Buttons color changed. Text kept readable.")

    def change_text_area_colors(self):
