        self.add_to_archive(line, newimg)

    def _cache_image_once(self, pil_img):
        key = id(pil_img)
        if key in self.fast_img_cache:
            return self.fast_img_cache[key]
        path = os.path.join(self.temp_dir, f"docimgfast_{key}.png")
