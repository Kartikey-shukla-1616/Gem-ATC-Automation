    def run_reupload_flow(self):
        if not self.image_archive:
            messagebox.showinfo("Archive", "No pages/images saved in archive.")
            return
        dlg = ArchiveDialog(self, self.image_archive)
        self.wait_window(dlg)
        entry = dlg.result
        if not entry:
            return

        oldline = entry["line"]
        to_delete = []
        for img_name in self.text.image_names():
            idx = self.text.index(img_name)
            if int(idx.split('.')[0]) == oldline:
                to_delete.append(idx)
        for idx in to_delete:
            self.text.delete(idx)

        self.tracked_images = [r for r in self.tracked_images if r[0] != oldline]
        self.pdf_images = [r for r in self.pdf_images if r[2] != oldline]
        self.docs_images = [r for r in self.docs_images if r[2] != oldline]
        self.image_archive = [e for e in self.image_archive if e["line"] != oldline]

        path = filedialog.askopenfilename(
            title=f"Select new image/PDF for line {oldline}",
            filetypes=[
                ("Images or PDF", "*.jpg *.jpeg *.png *.pdf"),
                ("Image Files", "*.jpg *.jpeg *.png"),
                ("PDF Files", "*.pdf"),
                ("All Files", "*.*"),
            ]
        )
        if not path:
            self.status_text.set("Reupload cancelled after clearing old page.")
            return

        ext = os.path.splitext(path)[1].lower()
        if ext != ".pdf":
            newimg = Image.open(path).convert("RGB")
            targetw, targeth = entry["width"], entry["height"]
            newimg = newimg.resize((targetw, targeth), Image.LANCZOS)
            newline = self.insert_image_on_newline(newimg, "center", aroundline=oldline, ispdf=True)
            self.status_text.set(f"Image reuploaded on fresh page near old line {oldline} -> line {newline}.")
            return

        with pdfplumber.open(path) as pdf:
            if not pdf.pages:
                messagebox.showerror("Error", "PDF has no pages.")
                return
            targetw, targeth = entry["width"], entry["height"]
            insert_after = oldline
            for page in pdf.pages:
                pageimg = page.to_image(resolution=300).original.convert("RGB")
                pageimg = pageimg.resize((targetw, targeth), Image.LANCZOS)
                insert_after = self.insert_image_on_newline(pageimg, "center", aroundline=insert_after, ispdf=True)
            self.status_text.set(f"Full new PDF reuploaded on fresh pages near old line {oldline}.")

