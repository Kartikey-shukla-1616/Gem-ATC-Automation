    def _normalize_insert_index_for_block(self, index=None):
        if index is None:
            try:
                index = self.text.index("insert")
            except Exception:
                index = "end-1c"

        line = int(self.text.index(index).split(".")[0])
        line_text = self.text.get(f"{line}.0", f"{line}.0 lineend")

        if line_text.strip():
            self.text.insert(f"{line}.0 lineend", "\n")
            return self.text.index(f"{line + 1}.0")
        return self.text.index(f"{line}.0")

    def insert_image_inline(self, pil_img, align="center", ispdf=False, isdocs=False, index=None):
        insert_index = self._normalize_insert_index_for_block(index)
        img_tk = ImageTk.PhotoImage(pil_img)
        self.tk_images.append(img_tk)

        self.text.mark_set("insert", insert_index)
        self.text.image_create(insert_index, image=img_tk)
        actual_index = self.text.index(insert_index)
        lineno = int(actual_index.split('.')[0])

        line_start = f"{lineno}.0"
        line_end = f"{lineno}.0 lineend"
        for tag in ("left", "center", "right"):
            self.text.tag_remove(tag, line_start, line_end)
        self.text.tag_add(align, line_start, line_end)

        self.text.insert(f"{lineno}.0 lineend", "\n")

        rec = (lineno, pil_img, align)
        self.tracked_images = [r for r in self.tracked_images if r[0] != lineno]
        self.tracked_images.append(rec)
        self.add_to_archive(lineno, pil_img)

        if ispdf:
            self.pdf_images = [r for r in self.pdf_images if r[2] != lineno]
            self.pdf_images.append(["img", None, lineno, pil_img, None, align])

        if isdocs:
            self.docs_images = [r for r in self.docs_images if r[2] != lineno]
            self.docs_images.append(["img", None, lineno, pil_img, None, align])

        self.text.mark_set("insert", f"{lineno + 1}.0")
        self.on_editor_change()
        return lineno

    def insert_image_on_newline(self, pil_img, align="center", aroundline=None, ispdf=False, isdocs=False):
        if aroundline is None:
            return self.insert_image_inline(pil_img, align, ispdf=ispdf, isdocs=isdocs)

        insertline = aroundline + 1
        self.text.insert(f"{insertline}.0", "\n")
        insertline = int(self.text.index(f"{insertline}.0").split('.')[0])

        img_tk = ImageTk.PhotoImage(pil_img)
        self.tk_images.append(img_tk)
        self.text.image_create(f"{insertline}.0", image=img_tk)
        self.text.insert(f"{insertline + 1}.0", "\n")

        line_start = f"{insertline}.0"
        line_end = f"{insertline}.0 lineend"
        for tag in ("left", "center", "right"):
            self.text.tag_remove(tag, line_start, line_end)
        self.text.tag_add(align, line_start, line_end)

        rec = (insertline, pil_img, align)
        self.tracked_images = [r for r in self.tracked_images if r[0] != insertline]
        self.tracked_images.append(rec)
        self.add_to_archive(insertline, pil_img)

        if ispdf:
            self.pdf_images = [r for r in self.pdf_images if r[2] != insertline]
            self.pdf_images.append(["img", None, insertline, pil_img, None, align])

        if isdocs:
            self.docs_images = [r for r in self.docs_images if r[2] != insertline]
            self.docs_images.append(["img", None, insertline, pil_img, None, align])

        self.text.mark_set("insert", f"{insertline + 1}.0")
        self.on_editor_change()
        return insertline

