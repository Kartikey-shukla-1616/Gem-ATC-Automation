    def center_on_screen(self, w, h):
        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()
        x = int((sw - w) / 2)
        y = int((sh - h) / 2)
        return f"{w}x{h}+{x}+{y}"

    def tag_add(self, tagname):
        try:
            self.text.tag_add(tagname, "sel.first", "sel.last")
        except tk.TclError:
            currentpos = self.text.index("insert")
            self.text.tag_add(tagname, currentpos, f"{currentpos} lineend")

    def set_alignment(self, align):
        try:
            start = self.text.index("sel.first")
            end = self.text.index("sel.last")
            for tag in ("left", "center", "right"):
                self.text.tag_remove(tag, start, end)
            self.text.tag_add(align, start, end)
        except tk.TclError:
            currentpos = self.text.index("insert")
            line_start = f"{currentpos} linestart"
            line_end = f"{currentpos} lineend"
            for tag in ("left", "center", "right"):
                self.text.tag_remove(tag, line_start, line_end)
            self.text.tag_add(align, line_start, line_end)

    def change_font_size(self, event=None):
        size = self.font_size_var.get()
        try:
            start = self.text.index("sel.first")
            end = self.text.index("sel.last")
            tagname = f"size{size}"
            self.text.tag_config(tagname, font=(self.font_name, size))
            self.text.tag_add(tagname, start, end)
            self.text_sizes[(start, end)] = size
            self.status_text.set(f"Font size set to {size} for selection.")
        except tk.TclError:
            currentpos = self.text.index("insert")
            tagname = f"size{size}"
            self.text.tag_config(tagname, font=(self.font_name, size))
            self.text.tag_add(tagname, currentpos, f"{currentpos} lineend")
            self.text_sizes[(currentpos, f"{currentpos} lineend")] = size
            self.status_text.set(f"Font size set to {size} for current line.")

    def make_heading(self):
        try:
            start = self.text.index("sel.first")
            end = self.text.index("sel.last")
            start_line = int(start.split(".")[0])
            end_line = int(end.split(".")[0])
        except tk.TclError:
            cur = self.text.index("insert")
            lineno = int(cur.split('.')[0])
            line_start = f"{lineno}.0"
            line_end = f"{lineno}.0 lineend"
            for img_name in self.text.image_names():
                idx = self.text.index(img_name)
                if int(idx.split('.')[0]) == lineno:
                    messagebox.showinfo("Info", "Image wali line ko heading nahi bana sakte. Heading ko image ke upar ya kisi text line par rakho.")
                    return
            start, end = line_start, line_end
            start_line = lineno
            end_line = lineno

        for line in range(start_line, end_line + 1):
            line_start = f"{line}.0"
            line_end = f"{line}.0 lineend"

            for tag in ("bold", "italic", "underline", "left", "right", "center", "bullet"):
                self.text.tag_remove(tag, line_start, line_end)

            self.text.tag_add("heading", line_start, line_end)
            self.text.tag_add("center", line_start, line_end)

            txt = self.text.get(line_start, line_end).strip()
            if txt:
                self.heading_pagebreak_lines.add(line)

        self.status_text.set("Selected text/line set as centered heading and will start from next page in PDF.")
        self.on_editor_change()

    def track_cursor(self, event):
        try:
